{
  "name": "@lazco-studio/pi-rich-model-selector",
  "version": "0.3.2",
  "description": "Pi extension: a model picker that shows context size, price, thinking levels, and key state, with starred models in your own order",
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "author": "OnCloud125252 <onc125252@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lazco-Corporation/pi-rich-model-selector.git"
  },
  "homepage": "https://github.com/Lazco-Corporation/pi-rich-model-selector#readme",
  "bugs": {
    "url": "https://github.com/Lazco-Corporation/pi-rich-model-selector/issues"
  },
  "keywords": [
    "pi",
    "pi-extension",
    "pi-package",
    "coding-agent",
    "model-picker",
    "tui"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ],
    "video": "https://lazco-public-15298932ec.pub.t4.txg1.lazco.cloud/pi-rich-model-selector/Demo.mp4"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "dependencies": {
    "proper-lockfile": "4.1.2"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.84.3",
    "@earendil-works/pi-coding-agent": "0.84.3",
    "@earendil-works/pi-tui": "0.84.3",
    "@types/node": "^22.20.1",
    "@types/proper-lockfile": "4.1.4",
    "typescript": "^5.9.2"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "bench": "node scripts/run-node-bench.mjs \"$PWD/scripts/bench-picker.ts\" && node scripts/run-node-bench.mjs \"$PWD/scripts/bench-open.ts\"",
    "verify": "node scripts/run-node-bench.mjs \"$PWD/scripts/verify/picker-order.ts\" && node scripts/run-node-bench.mjs \"$PWD/scripts/verify/picker-refresh.ts\"",
    "release": "bash scripts/release.sh"
  }
}
